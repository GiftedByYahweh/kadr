{
  "name": "kadr",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm infra:up && pnpm -r --parallel dev",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "docker:up": "docker compose --profile full up -d --build --wait",
    "docker:down": "docker compose --profile full down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~6.0.0"
  }
}
