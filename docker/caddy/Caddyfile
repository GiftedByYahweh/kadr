(immutable_assets) {
	@immutable path {args[0]}
	header @immutable Cache-Control "public, max-age=31536000, immutable"
}

(spa) {
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		root * {args[0]}
		import immutable_assets /assets/*
		try_files {path} /index.html
		file_server
	}
}

{$ADMIN_ADDRESS} {
	encode zstd gzip
	import spa /srv/admin
}

{$GALLERY_ADDRESS} {
	encode zstd gzip
	import spa /srv/gallery
}

{$PORTFOLIO_ADDRESS} {
	encode zstd gzip
	root * /srv/portfolio
	import immutable_assets /_astro/*
	try_files {path} {path}/ {path}.html
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
